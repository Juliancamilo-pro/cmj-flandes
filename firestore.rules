rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isPrincipalAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'trujillogordilloo@gmail.com' ||
        request.auth.token.email == 'trujillogordilooo@gmail.com'
      );
    }

    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test probe
    match /test/{testId} {
      allow read, write: if true;
    }

    // CMJ Flandes Institutional Collections (synced with backend RBAC)
    match /cmj_config/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /cmj_members/{memberId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /cmj_commissions/{commId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /cmj_sessions/{sessionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /cmj_documents/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /cmj_projects/{projId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /cmj_articles/{artId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /cmj_activities/{actId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /cmj_polls/{pollId} {
      allow read: if true;
      allow write: if true;
    }

    match /cmj_media/{mediaId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /cmj_proposals/{propId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    match /cmj_contact_messages/{msgId} {
      allow read: if isPrincipalAdmin() || isSignedIn();
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    match /cmj_audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
